# Signing and notarization credentials for macOS builds.
#
#   cp .env.example .env    then fill in the values below.
#
# .env is gitignored and excluded from the packaged app. Nothing here is read
# at runtime; it exists for `npm run package:mac` and `npm run release`.

# ── Notarization ────────────────────────────────────────────────────────────
# An App Store Connect API key, from App Store Connect > Users and Access >
# Integrations > App Store Connect API. The key downloads once; keep it in
# ~/.appstoreconnect/private_keys/ so notarytool and altool both find it.
# APPLE_API_ISSUER is the Issuer ID shown above the key list on that page.
APPLE_API_KEY=/Users/you/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
APPLE_TEAM_ID=

# An Apple ID with an app-specific password works instead. electron-builder
# checks for it FIRST, so setting APPLE_ID takes the key path out of play:
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Certificate ─────────────────────────────────────────────────────────────
# Leave these empty for local builds: electron-builder finds the "Developer ID
# Application" identity in your login keychain on its own. They exist for CI,
# where the certificate has to travel as a base64-encoded .p12.
# CSC_LINK=
# CSC_KEY_PASSWORD=
